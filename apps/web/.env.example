# Web environment. `pnpm.cmd setup:env` copies this to apps/web/.env.local if that file does not exist.
# Both values are public origins with no trailing slash. Never put a secret in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional. Your Razorpay TEST key id (rzp_test_...), the public half only. Never put the key secret here.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Optional: Sentry DSN for error reports. Only its ingest host is added to the Content Security Policy.
NEXT_PUBLIC_SENTRY_DSN=

# Server-only (not NEXT_PUBLIC_): the session cookie name the web server forwards to the API. Empty means bayana_session;
# a separate deployment on the same domain needs its own name. Must match the API's SESSION_COOKIE_NAME.
SESSION_COOKIE_NAME=
# Server-only: local | staging | production. Indexable only with production AND LEGAL_REVIEWED=true, and a production build refuses placeholder
# business details (apps/web/lib/business-details.ts). Empty means local.
APP_ENV=
# Server-only: set to true once a lawyer has reviewed the legal pages; until then they show a draft banner.
LEGAL_REVIEWED=
