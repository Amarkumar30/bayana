# API environment (SPEC Appendix A). `pnpm.cmd setup:env` copies this to apps/api/.env if that file does not exist
# and fills SESSION_SECRET and OTP_PEPPER with random local values. Never commit apps/api/.env.
# Placeholders below are safe for local development only.

# development | test | production
NODE_ENV=development
# local | staging | production
APP_ENV=local
PORT=4000
# Trusted proxy hops: 0 locally, 1 behind Render
TRUST_PROXY=0
# Comma-separated exact origins, no trailing slash; the first is used in emailed links
WEB_ORIGINS=http://localhost:3000
# Empty locally; .bayana.in in staging and production
SESSION_COOKIE_DOMAIN=

# Local Docker database (docker-compose.yml, host port 5433). Development databases must end in _dev.
DATABASE_URL=postgres://bayana:bayana@localhost:5433/bayana_dev
# Direct (unpooled) URL for migrations; required in production, falls back to DATABASE_URL locally
DATABASE_URL_DIRECT=
# Test database; the name must end in _test
DATABASE_URL_TEST=postgres://bayana:bayana@localhost:5433/bayana_test

HOLD_MINUTES=15
REQUEST_HOLD_HOURS=48
MIN_ADVANCE_PAISE=10000

# disabled | test | live. Keep disabled locally; live is refused outside production.
PAYMENT_MODE=disabled
LIVE_PAYMENTS_ACK=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# smtp | log (development only) | capture (test only, the default under NODE_ENV=test). Mailpit catches local mail: SMTP on 1025, inbox at http://localhost:8025
EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Bayana <hello@bayana.local>

# Random secrets. setup:env generates local values; use different ones in every deployed environment.
SESSION_SECRET=
OTP_PEPPER=
