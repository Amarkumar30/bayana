# Names only (SPEC Appendix A). Copy to apps/api/.env and fill in locally; never commit values.
# The web app reads its own variables from apps/web/.env.local (see apps/web/.env.example).

# development | test | production
NODE_ENV=
# local | staging | production
APP_ENV=
PORT=
# Number of trusted proxy hops (1 on Render, 0 locally)
TRUST_PROXY=
# Comma-separated exact origins; the first one is used in emailed links
WEB_ORIGINS=
# Empty locally; .bayana.in in staging and production
SESSION_COOKIE_DOMAIN=

# Runtime (pooled) connection
DATABASE_URL=
# Direct connection used only by migrations; required in production
DATABASE_URL_DIRECT=
# Test database; its name must end in _test
DATABASE_URL_TEST=

HOLD_MINUTES=
REQUEST_HOLD_HOURS=
MIN_ADVANCE_PAISE=

# disabled (default) | test | live. live also needs NODE_ENV=production and LIVE_PAYMENTS_ACK=yes
PAYMENT_MODE=
LIVE_PAYMENTS_ACK=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# smtp (default) | log (development only). Locally, Mailpit listens for SMTP on port 1025.
EMAIL_TRANSPORT=
SMTP_URL=
EMAIL_FROM=

# 32+ random bytes each; OTP_PEPPER is required in production
SESSION_SECRET=
OTP_PEPPER=
