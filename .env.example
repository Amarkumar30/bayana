# Database connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bayana?schema=public"

# Auth JWT Secrets (must be at least 32 characters)
JWT_ACCESS_SECRET="bayana-development-jwt-access-secret-at-least-32-chars-long"
JWT_REFRESH_SECRET="bayana-development-jwt-refresh-secret-at-least-32-chars-long"

# Razorpay Credentials (test keys from dashboard.razorpay.com)
RAZORPAY_KEY_ID="rzp_test_replace_me"
RAZORPAY_KEY_SECRET="replace_with_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="replace_with_webhook_secret_min_16_chars"

# Server & Client Ports
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

# Optional: Email Notifications (falls back to Ethereal dev inbox if omitted)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# EMAIL_FROM="\"Bayana\" <noreply@bayana.in>"
