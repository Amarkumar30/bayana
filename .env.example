# Runtime environment: development, test, or production.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
# PostgreSQL connection string. Use a database ending in _test for tests.
DATABASE_URL=postgres://bayana:bayana@localhost:5433/bayana
HOLD_MINUTES=15
MIN_ADVANCE_PAISE=10000
# disabled (default), test, or live. Never use live credentials locally.
PAYMENT_MODE=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# smtp in normal environments; log is permitted only in development.
EMAIL_TRANSPORT=log
SMTP_URL=
EMAIL_FROM=
# Use separate random secrets; OTP_PEPPER is required in production.
SESSION_SECRET=
OTP_PEPPER=
